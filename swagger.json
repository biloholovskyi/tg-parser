  "info": {
    "title": "TechAdminServer API",
    "description": "TechAdminServer REST API contract — log collection, statistics, system data management",
    "version": "0.2.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      },
      "api-key": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key"
      }
    },
    "schemas": {
      "SetupDto": {
        "type": "object",
        "properties": {
          "login": {
            "type": "string"
          },
          "password": {
            "type": "string",
            "minLength": 8
          }
        },
        "required": [
          "login",
          "password"
        ]
      },
      "SafeUserResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "login": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "nullable": true
          },
          "isActive": {
            "type": "boolean"
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "updatedAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "id",
          "login",
          "email",
          "isActive",
          "createdAt",
          "updatedAt"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "login": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        },
        "required": [
          "login",
          "password"
        ]
      },
      "AuthTokensResponse": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "refreshToken": {
            "type": "string"
          }
        },
        "required": [
          "accessToken",
          "refreshToken"
        ]
      },
      "RefreshDto": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string"
          }
        },
        "required": [
          "refreshToken"
        ]
      },
      "CreateAlertDto": {
        "type": "object",
        "properties": {
          "serviceName": {
            "type": "string",
            "maxLength": 100
          },
          "level": {
            "type": "string",
            "enum": [
              "info",
              "warning",
              "error"
            ]
          },
          "message": {
            "type": "string",
            "maxLength": 4000
          },
          "details": {
            "type": "object",
            "description": "Free-form context rendered as a collapsed block in Telegram"
          }
        },
        "required": [
          "serviceName",
          "level",
          "message"
        ]
      },
      "AlertAcceptedResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "deliveryStatus": {
            "type": "string",
            "enum": [
              "pending",
              "sending",
              "sent",
              "failed"
            ]
          }
        },
        "required": [
          "id",
          "createdAt",
          "deliveryStatus"
        ]
      },
      "AlertResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "serviceName": {
            "type": "string"
          },
          "level": {
            "type": "string",
            "enum": [
              "info",
              "warning",
              "error"
            ]
          },
          "message": {
            "type": "string"
          },
          "details": {
            "type": "object",
            "nullable": true
          },
          "deliveryStatus": {
            "type": "string",
            "enum": [
              "pending",
              "sending",
              "sent",
              "failed"
            ]
          },
          "deliveryAttempts": {
            "type": "number"
          },
          "nextAttemptAt": {
            "format": "date-time",
            "type": "string",
            "nullable": true
          },
          "lastError": {
            "type": "string",
            "nullable": true
          },
          "telegramMessageId": {
            "type": "number",
            "nullable": true
          },
          "sentAt": {
            "format": "date-time",
            "type": "string",
            "nullable": true
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "id",
          "serviceName",
          "level",
          "message",
          "deliveryStatus",
          "deliveryAttempts",
          "createdAt"
        ]
      },
      "PaginatedAlertsResponse": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AlertResponse"
            }
          },
          "total": {
            "type": "number"
          },
          "page": {
            "type": "number"
          },
          "limit": {
            "type": "number"
          },
          "totalPages": {
            "type": "number"
          }
        },
        "required": [
          "data",
          "total",
          "page",
          "limit",
          "totalPages"
        ]
      },
      "RailwayProjectUsageResponse": {
        "type": "object",
        "properties": {
          "projectId": {
            "type": "string"
          },
          "projectName": {
            "type": "string"
          },
          "cpu": {
            "type": "number",
            "description": "vCPU hours"
          },
          "memoryGb": {
            "type": "number",
            "description": "Memory usage in GB"
          },
          "networkEgressGb": {
            "type": "number",
